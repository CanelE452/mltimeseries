# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Caches
.cache/
.ipynb_checkpoints/

# Data and heavy artifacts are never committed
data/
!data/.gitkeep
runs/
!runs/.gitkeep

# Upstream repos are cloned, not vendored (scripts/ records how)
third_party/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz

# The blanket *.npz rule above is for model-sized arrays. The per-example loss
# archives are 2 MB of scores and keys, and an outside reader cannot recompute
# the effects or regenerate the bootstrap without them.
!results/**/per_example_losses.npz
*.parquet

# Credentials
.env
*.key
*.pem

# External raw data for UCP-PATH-PILOT-v1 (never committed)
data_external/*

# Study venv for TSFM-BENCHMARK-GAP-DISCOVERY-v1 (recreatable from configs/study.yaml)
.venv-tsfm/

# Per-origin loss archives are audit-critical and small (< 1 MB total); the blanket
# *.npz rule above is for model-sized arrays.
!results/tsfm_benchmark_gap_discovery_v1/origin_losses/*.npz

# The fev-bench task definition is the frozen evaluation contract, not raw data, so it
# is tracked. Git will not descend into an excluded directory, so the parents have to be
# re-included before the file itself can be.
!data_external/tsfm_benchmark_gap_discovery_v1/
data_external/tsfm_benchmark_gap_discovery_v1/*
!data_external/tsfm_benchmark_gap_discovery_v1/fev_bench_tasks.yaml

# Per-origin loss archives for the long-horizon closure: scaled losses, a window
# index and an item id, no target values. Same reasoning as the study above.
!results/tsfm_long_horizon_specialist_closure_v1/origin_losses/*.npz
