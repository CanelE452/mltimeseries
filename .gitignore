# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Caches
.cache/
.ipynb_checkpoints/

# Data and heavy artifacts are never committed
data/
!data/.gitkeep
runs/
!runs/.gitkeep

# Upstream repos are cloned, not vendored (scripts/ records how)
third_party/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz

# The blanket *.npz rule above is for model-sized arrays. The per-example loss
# archives are 2 MB of scores and keys, and an outside reader cannot recompute
# the effects or regenerate the bootstrap without them.
!results/**/per_example_losses.npz
*.parquet

# Credentials
.env
*.key
*.pem

# External raw data for UCP-PATH-PILOT-v1 (never committed)
data_external/
